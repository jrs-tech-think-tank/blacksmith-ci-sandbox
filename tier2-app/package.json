{
  "name": "tier2-build-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Tier 2 containerized build pipeline for the Blacksmith migration lab (npm + Docker layer caching).",
  "scripts": {
    "typecheck": "tsc --noEmit",
