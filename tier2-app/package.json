  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "express": "^4.21.2",
    "lodash": "^4.17.21",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
